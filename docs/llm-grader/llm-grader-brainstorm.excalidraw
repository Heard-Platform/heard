      "seed": 143674167,
      "version": 389,
      "versionNonce": 884532025,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776803141879,
      "link": null,
      "locked": false,
      "text": "What format should our LLM grader report be?\n\nWhat will we do with the information contained in\nthe report? Will it be processed by a human or a\ncomputer?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "urnwwWNp_Nwfh7hzl8AIr",
      "originalText": "What format should our LLM grader report be?\n\nWhat will we do with the information contained in the report? Will it be processed by a human or a computer?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dKCoa5YSXvcG2Rk8rX1HD",
      "type": "line",
      "x": 411.0453416303392,
      "y": 1268.4615193996106,
      "width": 78.8243338774987,
      "height": 0.33036973132152525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": {
        "type": 2
      },
      "seed": 1807886585,
      "version": 93,
      "versionNonce": 1637285945,
      "isDeleted": false,
