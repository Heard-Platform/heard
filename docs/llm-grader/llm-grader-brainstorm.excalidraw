    {
      "id": "VHsrEB6yHjk8wOPt0yhnp",
      "type": "text",
      "x": 518.7930493524227,
      "y": 1210.449064968502,
      "width": 481.99969482421875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
