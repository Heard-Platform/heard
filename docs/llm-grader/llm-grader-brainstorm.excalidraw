      "boundElements": [],
      "updated": 1776801940122,
      "link": null,
      "locked": false,
      "text": "Expected values (NL)\n\"These general dates are good: The weekend of\nApril 25th and 26th, and the week after that.\nThese suggestions would be bad: This Thursday,\nnext Wednesday evening, and Friday of this week.\nThe rest is too vague to be useful.\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "6M7KCay7ih-668aW-heEG",
      "originalText": "Expected values (NL)\n\"These general dates are good: The weekend of April 25th and 26th, and the week after that. These suggestions would be bad: This Thursday, next Wednesday evening, and Friday of this week. The rest is too vague to be useful.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
