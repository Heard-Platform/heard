    {
      "id": "note_1144",
      "type": "text",
      "x": 70,
      "y": 820,
      "width": 400,
      "height": 185,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1145,
      "version": 1,
      "versionNonce": 1146,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 5,
      "text": "Key points\n• Selector persists to localStorage + user record\n• UI strings: react-i18next, en→es fallback\n• Content: idempotent, keyed on text\n• i18n as open Record<lang> — no migration;\n   extra languages are additive\n• Failure → needsTranslation flag (in the data)\n• Vote/update path re-saves, never re-translates\n• Translate once → every user sees the same\n   translation (debate integrity)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key points\n• Selector persists to localStorage + user record\n• UI strings: react-i18next, en→es fallback\n• Content: idempotent, keyed on text\n• i18n as open Record<lang> — no migration;\n   extra languages are additive\n• Failure → needsTranslation flag (in the data)\n• Vote/update path re-saves, never re-translates\n• Translate once → every user sees the same\n   translation (debate integrity)",
      "lineHeight": 1.35,
      "baseline": 12,
      "index": "a0062",
      "autoResize": false
    }
  ],
  "appState": {
    "gridSize": null,
    "viewBackgroundColor": "#ffffff"
  },
