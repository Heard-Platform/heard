      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 5,
      "text": "Key points\n• Selector persists to localStorage + user record\n• UI strings: react-i18next, en→es fallback\n• Content: synchronous & bidirectional\n• Stored inline in JSONB — no migration\n• Translate once → every user sees the same\n   translation (debate integrity)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key points\n• Selector persists to localStorage + user record\n• UI strings: react-i18next, en→es fallback\n• Content: synchronous & bidirectional\n• Stored inline in JSONB — no migration\n• Translate once → every user sees the same\n   translation (debate integrity)",
      "lineHeight": 1.35,
      "baseline": 12,
      "index": "a0058",
      "autoResize": false
    }
